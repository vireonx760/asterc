/* Fixed-width Advanced SIMD; element width is an explicit native operand. */
#define AST_NEON(id, text, shape, word)                                        \
  AST_VECTOR_FORM(A64_##id, text, AARCH64, A64_##shape, word, 0, 0)
AST_NEON(ADD, "add", INTEGER, 0x0e208400u)
AST_NEON(SUB, "sub", INTEGER, 0x2e208400u)
AST_NEON(MUL, "mul", SMALL_INTEGER, 0x0e209c00u)
AST_NEON(SQADD, "sqadd", INTEGER, 0x0e200c00u)
AST_NEON(UQADD, "uqadd", INTEGER, 0x2e200c00u)
AST_NEON(SQSUB, "sqsub", INTEGER, 0x0e202c00u)
AST_NEON(UQSUB, "uqsub", INTEGER, 0x2e202c00u)
AST_NEON(SHADD, "shadd", SMALL_INTEGER, 0x0e200400u)
AST_NEON(UHADD, "uhadd", SMALL_INTEGER, 0x2e200400u)
AST_NEON(SRHADD, "srhadd", SMALL_INTEGER, 0x0e201400u)
AST_NEON(URHADD, "urhadd", SMALL_INTEGER, 0x2e201400u)
AST_NEON(CMEQ, "cmeq", INTEGER, 0x2e208c00u)
AST_NEON(CMGT, "cmgt", INTEGER, 0x0e203400u)
AST_NEON(CMGE, "cmge", INTEGER, 0x0e203c00u)
AST_NEON(CMHI, "cmhi", INTEGER, 0x2e203400u)
AST_NEON(CMHS, "cmhs", INTEGER, 0x2e203c00u)
AST_NEON(AND, "and", LOGIC, 0x0e201c00u)
AST_NEON(BIC, "bic", LOGIC, 0x0e601c00u)
AST_NEON(ORR, "orr", LOGIC, 0x0ea01c00u)
AST_NEON(ORN, "orn", LOGIC, 0x0ee01c00u)
AST_NEON(EOR, "eor", LOGIC, 0x2e201c00u)
AST_NEON(FADD, "fadd", FLOAT, 0x0e20d400u)
AST_NEON(FSUB, "fsub", FLOAT, 0x0ea0d400u)
AST_NEON(FMUL, "fmul", FLOAT, 0x2e20dc00u)
AST_NEON(FDIV, "fdiv", FLOAT, 0x2e20fc00u)
AST_NEON(FMIN, "fmin", FLOAT, 0x0ea0f400u)
AST_NEON(FMAX, "fmax", FLOAT, 0x0e20f400u)
AST_NEON(FMINNM, "fminnm", FLOAT, 0x0ea0c400u)
AST_NEON(FMAXNM, "fmaxnm", FLOAT, 0x0e20c400u)
/* The native address is in a GPR; these forms use unsigned scaled imm12. */
AST_NEON(LDR, "ldr", LOAD, 0u)
AST_NEON(STR, "str", STORE, 0u)
#undef AST_NEON
