module mir.gvn_large;

export fn repeated(a: u64, b: u64) -> u64 @abi(c) {
    let first: u64 = a * b;
    let second: u64 = a * b;
    let third: u64 = a * b;
    return first + second + third;
}

export fn across_blocks(a: u64, b: u64, flag: bool) -> u64 @abi(c) {
    let first: u64 = a + b;
    if flag {
        let second: u64 = a + b;
        return first + second;
    }
    return first;
}

export fn different_ops(a: u64, b: u64) -> u64 @abi(c) {
    let first: u64 = a + b;
    let second: u64 = a - b;
    return first ^ second;
}

export fn division_effects(a: u64, b: u64) -> u64 @abi(c) {
    let first: u64 = a / b;
    let second: u64 = a / b;
    return first + second;
}

export fn identities(a: u64) -> u64 @abi(c) {
    let p: u64 = a + 0;
    let q: u64 = p * 1;
    let r: u64 = q ^ 0;
    let s: u64 = r - 0;
    return s | 0;
}

export fn sibling_paths(a: u64, b: u64, flag: bool) -> u64 @abi(c) {
    if flag {
        let left: u64 = a + b;
        return left;
    } else {
        let right: u64 = a + b;
        return right;
    }
}

