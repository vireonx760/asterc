udiv {dst:out,lhs:a,rhs:b};
lslv {dst:out,lhs:a,rhs:b};
lsrv {dst:out,lhs:a,rhs:b};
asrv {dst:out,lhs:a,rhs:b};
rorv {dst:out,lhs:a,rhs:b};
smulh {dst:out,lhs:a,rhs:b};
umulh {dst:out,lhs:a,rhs:b};
clz {dst:out,src:a};
cls {dst:out,src:a};
rbit {dst:out,src:a};
rev16 {dst:out,src:a};
rev32 {dst:out,src:a};
rev {dst:out,src:a};
madd {dst:out,lhs:a,rhs:b,acc:acc};
msub {dst:out,lhs:a,rhs:b,acc:acc};
smaddl {dst:out,lhs:a,rhs:b,acc:acc};
smsubl {dst:out,lhs:a,rhs:b,acc:acc};
umaddl {dst:out,lhs:a,rhs:b,acc:acc};
umsubl {dst:out,lhs:a,rhs:b,acc:acc};
extr {dst:out,lhs:a,rhs:b,lsb:13};
movz {dst:out,imm:33059,shift:16};
movn {dst:out,imm:33059,shift:16};
movk {dst:out,imm:33059,shift:16};
sbfm {dst:out,src:a,immr:13,imms:27};
ubfm {dst:out,src:a,immr:13,imms:27};
bfm {dst:out,src:a,immr:13,imms:27};
} return out^live; }
