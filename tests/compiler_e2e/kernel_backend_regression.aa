module compiler.kernel_backend_regression;

type IdtEntry = struct {
    offset_low: u16;
    selector: u16;
    ist_res: u8;
    type_attr: u8;
    offset_mid: u16;
    offset_high: u32;
    reserved: u32;
};

section ".rodata" @readonly @align(16) {
    const scan_to_ascii: [u8; 60] = {
        0, 27, 49, 50, 51, 52, 53, 54, 55, 56, 57, 48, 45, 61, 8,
        9, 81, 87, 69, 82, 84, 89, 85, 73, 79, 80, 91, 93, 10, 0,
        65, 83, 68, 70, 71, 72, 74, 75, 76, 59, 39, 96, 0, 92,
        90, 88, 67, 86, 66, 78, 77, 44, 46, 47, 0, 42, 0, 32
    };
}
section ".bss" @writable @align(16) {
    global idt: [IdtEntry; 256];
}

fn handler() @abi(c) { }

export fn install(vector: usize) -> u64 @abi(c) {
    unsafe {
        let handler_address: usize = ptr_to_int(&handler);
        let base_idt_addr: usize = ptr_to_int(&idt);
        let p_entry: ptr<IdtEntry> = int_to_ptr(base_idt_addr + vector * 16);
        let p_low: ptr<u16> = int_to_ptr(ptr_to_int(p_entry));
        let p_mid: ptr<u16> = int_to_ptr(ptr_to_int(p_entry) + 6);
        let p_high: ptr<u32> = int_to_ptr(ptr_to_int(p_entry) + 8);
        store.u16 [p_low] = cast<u16>(handler_address & 0xffff);
        store.u16 [p_mid] = cast<u16>((handler_address >> 16) & 0xffff);
        store.u32 [p_high] = cast<u32>((handler_address >> 32) & 0xffffffff);
        let table: ptr<const u8> = int_to_ptr(ptr_to_int(&scan_to_ascii) + 59);
        return zext<u64>(load.u8 [table]);
    }
}
