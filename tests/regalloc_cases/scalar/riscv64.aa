module scalar.riscv64;
export fn managed(a:u64,b:u64,seed:u64)->u64 {
    let live:u64=seed*17+9; let out:u64;
    exact riscv64 inputs(a,b) outputs(out) {
        add {dst:out,lhs:a,rhs:b};
        sub {dst:out,lhs:a,rhs:b};
        sll {dst:out,lhs:a,rhs:b};
        slt {dst:out,lhs:a,rhs:b};
        sltu {dst:out,lhs:a,rhs:b};
        xor {dst:out,lhs:a,rhs:b};
        srl {dst:out,lhs:a,rhs:b};
        sra {dst:out,lhs:a,rhs:b};
        or {dst:out,lhs:a,rhs:b};
        and {dst:out,lhs:a,rhs:b};
        addi {dst:out,lhs:a,rhs:1};
        slti {dst:out,lhs:a,rhs:1};
        sltiu {dst:out,lhs:a,rhs:1};
        xori {dst:out,lhs:a,rhs:1};
        ori {dst:out,lhs:a,rhs:1};
        andi {dst:out,lhs:a,rhs:1};
        slli {dst:out,lhs:a,rhs:1};
        srli {dst:out,lhs:a,rhs:1};
        srai {dst:out,lhs:a,rhs:1};
        addw {dst:out,lhs:a,rhs:b};
        subw {dst:out,lhs:a,rhs:b};
        sllw {dst:out,lhs:a,rhs:b};
        srlw {dst:out,lhs:a,rhs:b};
        sraw {dst:out,lhs:a,rhs:b};
        addiw {dst:out,lhs:a,rhs:1};
        slliw {dst:out,lhs:a,rhs:1};
        srliw {dst:out,lhs:a,rhs:1};
        sraiw {dst:out,lhs:a,rhs:1};
        lui {dst:out,imm:1};
        auipc {dst:out,imm:1};
        mul {dst:out,lhs:a,rhs:b};
        mulh {dst:out,lhs:a,rhs:b};
        mulhsu {dst:out,lhs:a,rhs:b};
        mulhu {dst:out,lhs:a,rhs:b};
        div {dst:out,lhs:a,rhs:b};
        divu {dst:out,lhs:a,rhs:b};
        rem {dst:out,lhs:a,rhs:b};
        remu {dst:out,lhs:a,rhs:b};
        mulw {dst:out,lhs:a,rhs:b};
        divw {dst:out,lhs:a,rhs:b};
        divuw {dst:out,lhs:a,rhs:b};
        remw {dst:out,lhs:a,rhs:b};
        remuw {dst:out,lhs:a,rhs:b};
    }
    return out^live;
}
export fn manual() @naked {
