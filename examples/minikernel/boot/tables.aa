module boot.tables;
// Fixed layout: GDT at 0x7d80, GDTR at 0x7da0, DAP at 0x7da8.
// DAP loads 112 sectors from LBA 1 into 0x1000:0000 (below a 64 KiB boundary).
// The final two bytes are the BIOS signature. All bytes here are data.
export fn tables() -> void @naked {
    unsafe exact x86_64 { bytes {
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0xff,0xff,0x00,0x00,0x00,0x9a,0xcf,0x00,
        0xff,0xff,0x00,0x00,0x00,0x92,0xcf,0x00,0xff,0xff,0x00,0x00,0x00,0x9a,0xaf,0x00,
        0x1f,0x00,0x80,0x7d,0x00,0x00,0x00,0x00,0x10,0x00,0x70,0x00,0x00,0x00,0x00,0x10,
        0x01,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,
        0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x55,0xaa
    }; }
}
