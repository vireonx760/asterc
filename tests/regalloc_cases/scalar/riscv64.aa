export fn bit_extension(a:u64,b:u64)->u64 {let out:u64; exact riscv64 inputs(a,b) outputs(out) {
    andn {dst:out,lhs:a,rhs:b};
    orn {dst:out,lhs:a,rhs:b};
    xnor {dst:out,lhs:a,rhs:b};
    min {dst:out,lhs:a,rhs:b};
    minu {dst:out,lhs:a,rhs:b};
    max {dst:out,lhs:a,rhs:b};
    maxu {dst:out,lhs:a,rhs:b};
    rol {dst:out,lhs:a,rhs:b};
    ror {dst:out,lhs:a,rhs:b};
    rolw {dst:out,lhs:a,rhs:b};
    rorw {dst:out,lhs:a,rhs:b};
    add.uw {dst:out,lhs:a,rhs:b};
    sh1add {dst:out,lhs:a,rhs:b};
    sh2add {dst:out,lhs:a,rhs:b};
    sh3add {dst:out,lhs:a,rhs:b};
    sh1add.uw {dst:out,lhs:a,rhs:b};
    sh2add.uw {dst:out,lhs:a,rhs:b};
    sh3add.uw {dst:out,lhs:a,rhs:b};
    clmul {dst:out,lhs:a,rhs:b};
    clmulr {dst:out,lhs:a,rhs:b};
    clmulh {dst:out,lhs:a,rhs:b};
    bset {dst:out,lhs:a,rhs:b};
    bclr {dst:out,lhs:a,rhs:b};
    binv {dst:out,lhs:a,rhs:b};
    bext {dst:out,lhs:a,rhs:b};
    clz {dst:out,src:a};
    ctz {dst:out,src:a};
    cpop {dst:out,src:a};
    clzw {dst:out,src:a};
    ctzw {dst:out,src:a};
    cpopw {dst:out,src:a};
    sext.b {dst:out,src:a};
    sext.h {dst:out,src:a};
    zext.h {dst:out,src:a};
    orc.b {dst:out,src:a};
    rev8 {dst:out,src:a};
    rori {dst:out,lhs:a,rhs:31};
    roriw {dst:out,lhs:a,rhs:31};
    slli.uw {dst:out,lhs:a,rhs:31};
    bseti {dst:out,lhs:a,rhs:31};
    bclri {dst:out,lhs:a,rhs:31};
    binvi {dst:out,lhs:a,rhs:31};
    bexti {dst:out,lhs:a,rhs:31};
}return out;}

export fn bit_manual() @naked {unsafe exact riscv64 {
    andn {dst:a0,lhs:a1,rhs:a2};
    orn {dst:a0,lhs:a1,rhs:a2};
    xnor {dst:a0,lhs:a1,rhs:a2};
    min {dst:a0,lhs:a1,rhs:a2};
    minu {dst:a0,lhs:a1,rhs:a2};
    max {dst:a0,lhs:a1,rhs:a2};
    maxu {dst:a0,lhs:a1,rhs:a2};
    rol {dst:a0,lhs:a1,rhs:a2};
    ror {dst:a0,lhs:a1,rhs:a2};
    rolw {dst:a0,lhs:a1,rhs:a2};
    rorw {dst:a0,lhs:a1,rhs:a2};
    add.uw {dst:a0,lhs:a1,rhs:a2};
    sh1add {dst:a0,lhs:a1,rhs:a2};
    sh2add {dst:a0,lhs:a1,rhs:a2};
    sh3add {dst:a0,lhs:a1,rhs:a2};
    sh1add.uw {dst:a0,lhs:a1,rhs:a2};
    sh2add.uw {dst:a0,lhs:a1,rhs:a2};
    sh3add.uw {dst:a0,lhs:a1,rhs:a2};
    clmul {dst:a0,lhs:a1,rhs:a2};
    clmulr {dst:a0,lhs:a1,rhs:a2};
    clmulh {dst:a0,lhs:a1,rhs:a2};
    bset {dst:a0,lhs:a1,rhs:a2};
    bclr {dst:a0,lhs:a1,rhs:a2};
    binv {dst:a0,lhs:a1,rhs:a2};
    bext {dst:a0,lhs:a1,rhs:a2};
    clz {dst:a0,src:a1};
    ctz {dst:a0,src:a1};
    cpop {dst:a0,src:a1};
    clzw {dst:a0,src:a1};
    ctzw {dst:a0,src:a1};
    cpopw {dst:a0,src:a1};
    sext.b {dst:a0,src:a1};
    sext.h {dst:a0,src:a1};
    zext.h {dst:a0,src:a1};
    orc.b {dst:a0,src:a1};
    rev8 {dst:a0,src:a1};
    rori {dst:a0,lhs:a1,rhs:31};
    roriw {dst:a0,lhs:a1,rhs:31};
    slli.uw {dst:a0,lhs:a1,rhs:31};
    bseti {dst:a0,lhs:a1,rhs:31};
    bclri {dst:a0,lhs:a1,rhs:31};
    binvi {dst:a0,lhs:a1,rhs:31};
    bexti {dst:a0,lhs:a1,rhs:31};
ret;}}
