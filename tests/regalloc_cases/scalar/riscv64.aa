        ret;
    }
}
export fn branch_beq() @naked {
    exact riscv64 {
        beq {lhs:a0,rhs:a1,target:taken};
        addi {dst:a0,lhs:zero,rhs:11};
        jal {dst:zero,target:done};
        label {name:taken};
        addi {dst:a0,lhs:zero,rhs:29};
        label {name:done}; ret;
    }
}

export fn branch_bne() @naked {
    exact riscv64 {
        bne {lhs:a0,rhs:a1,target:taken};
        addi {dst:a0,lhs:zero,rhs:11};
        jal {dst:zero,target:done};
        label {name:taken};
        addi {dst:a0,lhs:zero,rhs:29};
        label {name:done}; ret;
    }
}

