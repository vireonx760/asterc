export fn folded_u64(a: u64) -> u64 @abi(c) {
    let x: u64 = 131;
    let y: u64 = 17;
    let p: u64 = x * y;
    let q: u64 = p + 97;
    let r: u64 = q ^ 27;
    return r + a;
}
