module guide.fnv1a;

// FNV-1a hashing of an explicitly bounded byte range.
export fn run() -> u32 @abi(c) {
    if hash(c"hello", 5) != 0x4f9f2cab { return 1; }
    return 42;
}
// u32 multiplication wraps modulo 2^32, as required by FNV-1a.
fn hash(bytes: ptr<const u8>, count: usize) -> u32 {
    let state: u32 = 2166136261; let i: usize = 0;
    while i < count {
        state = (state ^ zext<u32>(load.u8 [&bytes[i]])) * 16777619;
        i = i + 1;
    }
    return state;
}
