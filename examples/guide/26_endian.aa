module guide.endian;
// A byte-by-byte reader also works for unaligned packet data.
export fn read_be32(data:ptr<const u8>)->u32 @abi(c) {
    let a:u32=zext<u32>(load.u8 [&data[0]]);
    let b:u32=zext<u32>(load.u8 [&data[1]]);
    let c:u32=zext<u32>(load.u8 [&data[2]]);
    let d:u32=zext<u32>(load.u8 [&data[3]]);
    return (a<<24)|(b<<16)|(c<<8)|d;
}
