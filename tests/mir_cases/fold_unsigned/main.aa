export fn a64_add_4095(a: u32) -> u32 @abi(c) { return a + 4095; }
export fn a64_add_4096(a: u32) -> u32 @abi(c) { return a + 4096; }
export fn a64_add_4097(a: u32) -> u32 @abi(c) { return a + 4097; }
export fn a64_add_16773120(a: u32) -> u32 @abi(c) { return a + 16773120; }
export fn a64_add_2000000000(a: u32) -> u32 @abi(c) { return a + 2000000000; }
