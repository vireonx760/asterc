  AST_VECTOR_EVEX(id##PS, text "ps", BINARY, (0x100u | op),                    \
                  AST_TARGET_FEATURE_X86_AVX512F)                              \
  AST_VECTOR_EVEX(id##PD, text "pd", BINARY, (0x1000500u | op),                \
                  AST_TARGET_FEATURE_X86_AVX512F)
