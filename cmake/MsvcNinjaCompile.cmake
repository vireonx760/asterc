# Compiler launcher: keep /sourceDependencies JSON independent of the console
# language/code page, and fail instead of silently losing header dependencies.
set(_aster_args "")
set(_aster_started FALSE)
set(_aster_object "")
math(EXPR _aster_last "${CMAKE_ARGC} - 1")
foreach(_aster_index RANGE 0 ${_aster_last})
    set(_aster_arg "${CMAKE_ARGV${_aster_index}}")
    if(NOT _aster_started)
        if(_aster_arg STREQUAL "--")
            set(_aster_started TRUE)
        endif()
        continue()
    endif()
    if(_aster_arg STREQUAL "/showIncludes")
        continue()
    endif()
    # A trailing backslash escapes the next separator in a CMake list. MSVC's
    # default Debug /Fd argument names a directory and ends in one; normalize
    # that path separator without touching literal /D macro payloads.
    if(_aster_arg MATCHES "^/(Fd|Fo|I|FI).*[\\\\]$")
        string(REGEX REPLACE "[\\\\]$" "/" _aster_arg "${_aster_arg}")
    endif()
    if(_aster_arg MATCHES "^/Fo(.+)$")
        set(_aster_object "${CMAKE_MATCH_1}")
    endif()
    list(APPEND _aster_args "${_aster_arg}")
endforeach()
if(NOT _aster_started OR NOT _aster_object)
    message(FATAL_ERROR "MSVC dependency launcher requires a compiler command and /Fo<object>.")
endif()
set(_aster_json "${_aster_object}.dependencies.json")
file(REMOVE "${_aster_json}")
execute_process(COMMAND ${_aster_args} /sourceDependencies "${_aster_json}"
    RESULT_VARIABLE _aster_result)
if(NOT _aster_result EQUAL 0)
    message(FATAL_ERROR "MSVC compilation failed (${_aster_result}).")
endif()
if(NOT EXISTS "${_aster_json}")
    message(FATAL_ERROR "MSVC produced no dependency JSON; incremental compilation would be unsafe.")
endif()
file(READ "${_aster_json}" _aster_data)
string(JSON _aster_count LENGTH "${_aster_data}" Data Includes)
if(_aster_count GREATER 0)
    math(EXPR _aster_last "${_aster_count} - 1")
    foreach(_aster_index RANGE 0 ${_aster_last})
        string(JSON _aster_header GET "${_aster_data}" Data Includes ${_aster_index})
        message("Note: including file: ${_aster_header}")
    endforeach()
endif()
