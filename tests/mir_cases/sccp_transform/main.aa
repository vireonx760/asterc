module mir.sccp_transform;

export fn phi_arithmetic(flag: bool) -> u64 @abi(c) {
    let result: u64 = 0;
    if flag { result = 42; } else { result = 42; }
    return (result + 3) * 7;
}

export fn phi_arithmetic_u32(flag: bool) -> u32 @abi(c) {
    let result: u32 = 0;
    if flag { result = 40; } else { result = 40; }
    return (result + 2) << 2;
}

export fn divergent(flag: bool) -> u64 @abi(c) {
    let value: u64 = 0;
    if flag { value = 17; } else { value = 29; }
    return value + 7;
}

export fn branch_path(flag: bool) -> u64 @abi(c) {
    let value: u64 = 0;
    if true { value = 91; } else { value = 44; }
    return (value ^ 7) + 5;
}

export fn branch_false(flag: bool) -> u64 @abi(c) {
    let result: u64 = 0;
    if false { result = 777; } else { result = 29; }
    return result;
}

export fn dynamic_with_div(value: u64, factor: u64) -> u64 @abi(c) {
    return (value / factor) + ((23 + 4) * 5);
}

export fn loop_counter(limit: u64) -> u64 @abi(c) {
    let counter: u64 = 0;
    while counter < limit { counter = counter + 1; }
    return counter;
}

