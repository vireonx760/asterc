        srai {dst:a0,lhs:a1,rhs:1};
        addw {dst:a0,lhs:a1,rhs:a2};
        subw {dst:a0,lhs:a1,rhs:a2};
        sllw {dst:a0,lhs:a1,rhs:a2};
        srlw {dst:a0,lhs:a1,rhs:a2};
        sraw {dst:a0,lhs:a1,rhs:a2};
        addiw {dst:a0,lhs:a1,rhs:1};
        slliw {dst:a0,lhs:a1,rhs:1};
        srliw {dst:a0,lhs:a1,rhs:1};
        sraiw {dst:a0,lhs:a1,rhs:1};
        lui {dst:a0,imm:1};
        auipc {dst:a0,imm:1};
        mul {dst:a0,lhs:a1,rhs:a2};
        mulh {dst:a0,lhs:a1,rhs:a2};
        mulhsu {dst:a0,lhs:a1,rhs:a2};
        mulhu {dst:a0,lhs:a1,rhs:a2};
        div {dst:a0,lhs:a1,rhs:a2};
        divu {dst:a0,lhs:a1,rhs:a2};
        rem {dst:a0,lhs:a1,rhs:a2};
        remu {dst:a0,lhs:a1,rhs:a2};
        mulw {dst:a0,lhs:a1,rhs:a2};
        divw {dst:a0,lhs:a1,rhs:a2};
        divuw {dst:a0,lhs:a1,rhs:a2};
        remw {dst:a0,lhs:a1,rhs:a2};
        remuw {dst:a0,lhs:a1,rhs:a2};
        ret;
    }
}
